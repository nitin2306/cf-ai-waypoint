{
  "name": "cf-ai-waypoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:demo": "npm run build && wrangler dev --config wrangler.demo.jsonc --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src worker tests '*.ts' '*.json' '*.jsonc' '*.md' index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:deployed": "node scripts/verify-deployment.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .deploy-check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.40.0"
  }
}
